generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WordList {
  id         String     @id @default(uuid())
  name       String
  words      Word[]
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Word {
  id          String    @id @default(uuid())
  englishWord String
  phonemes    Phoneme[]
  wordListId  String
  wordList    WordList  @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  activities Activity[]
}

model Phoneme {
  id       String @id @default(uuid())
  symbol   String
  position Int
  wordId   String
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model Activity {
  id              String       @id @default(uuid())
  name            String
  type            ActivityType
  difficulty      Difficulty
  showHints       Boolean      @default(true)
  numberOfGuesses Int?
  gridSize        Int?
  puzzleData      Json?
  wordListId      String
  wordList        WordList     @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  wordId String?
  word   Word? @relation(fields: [wordId], references: [id], onDelete: SetNull)
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}